# Base Docs public testnet endpoint. It is rate-limited; use a provider for sustained traffic.
export BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Import the admin/deployer key into Foundry's keystore; never place it in this file:
# cast wallet import deployer --interactive
export FACILITY_ADMIN=0x0000000000000000000000000000000000000000
export ORIGINATOR_OPERATOR=0x0000000000000000000000000000000000000000
export EXPOSURE_ISSUER=0x0000000000000000000000000000000000000000
export HEDGE_ISSUER=0x0000000000000000000000000000000000000000

# Must equal the standalone repository HEAD used for deployment.
export SOURCE_COMMIT=

# Foundry/Etherscan API V2 uses one Etherscan key for BaseScan verification.
export ETHERSCAN_API_KEY=
