# Base Sepolia only. Use disposable, funded testnet keys and never commit the populated file.
export BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
export DEPLOYMENT_MANIFEST=deployments/base-sepolia.json

# Each key must derive to the corresponding address recorded in the deployment manifest.
export ADMIN_PRIVATE_KEY=
export OPERATOR_PRIVATE_KEY=
export EXPOSURE_ISSUER_PRIVATE_KEY=
export HEDGE_ISSUER_PRIVATE_KEY=

# Run "initial", wait until the recorded cure deadline, then run "finalize".
export SCENARIO_PHASE=initial
