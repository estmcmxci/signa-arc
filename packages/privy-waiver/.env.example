# Copy to packages/privy-waiver/.env (gitignored) and fill in. Never commit the filled-in file.

# From dashboard.privy.io, App settings. Required for everything except key-setup mode.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The quorum-owned admin wallet. Printed by scripts/smoke.ts --public-keys=... (WIRE-UP.md step 4).
# Leave empty to run the server in key-setup mode, where approvers create their keys.
PRIVY_WALLET_ID=

# The quorum facility's CovenantVault, once deployed (WIRE-UP.md step 7).
PRIVY_WAIVER_VAULT=

# Optional
# PRIVY_API_URL=https://api.privy.io
# PRIVY_QUORUM_FACILITY_LABEL=signa-covenant-arc-eur-usd-privy-quorum
# PRIVY_WAIVER_STORE=/absolute/path/outside/the/repo/actions.json
# PORT=8787
