{
  "name": "@fx-coverage/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "abi:generate": "node scripts/generate-abi.mjs",
    "abi:check": "node scripts/generate-abi.mjs --check",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "check": "pnpm abi:check && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-query": "5.102.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "viem": "^2.56.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "vite": "^7.2.2"
  }
}
