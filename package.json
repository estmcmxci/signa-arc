{
  "name": "fx-coverage-controls",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "forge build",
    "test:contracts": "forge test --offline",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json",
    "test:ts": "node --import tsx --test packages/*/test/*.test.ts scripts/test/*.test.ts",
    "dashboard:build": "pnpm --filter @fx-coverage/dashboard build",
    "signa": "node --import tsx packages/cli/src/bin.ts",
    "generate:abis": "node --import tsx scripts/generate-abis.ts",
    "generate:docs": "node --import tsx scripts/generate-docs-evidence.ts",
    "docs:dev": "pnpm --filter @signa/docs dev",
    "docs:build": "pnpm --filter @signa/docs build",
    "docs:preview": "pnpm --filter @signa/docs preview",
    "docs:check": "tsc --noEmit -p apps/docs/tsconfig.json && pnpm docs:build && node --import tsx apps/docs/scripts/verify-build.ts",
    "check": "pnpm build:contracts && pnpm typecheck && pnpm test:ts && pnpm test:contracts && pnpm dashboard:build && pnpm docs:check"
  },
  "dependencies": {
    "@fx-coverage/credentials": "workspace:*",
    "@fx-coverage/provider-adapter": "workspace:*",
    "viem": "^2.56.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
